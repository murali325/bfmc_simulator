<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='automobile'>
    <include>
      <uri>model://chassis</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- including a left rear wheel -->
    <include>
      <uri>model://wheel_left</uri>
      <pose>-0.152 0.081 0 0 0 0</pose>
      <name>wheel_rear_left</name>
    </include>
    <!-- including a front rear wheel -->
    <include>
      <uri>model://wheel_right</uri>
      <pose>-0.152 -0.081 0 0 0 0</pose>
      <name>wheel_rear_right</name>
    </include>
    <!-- including a left steering comp. -->
    <include>
      <uri>model://steering_column</uri>
      <pose>0.112 0.0725 0 0 0 0</pose>
      <name>steer_left</name>
    </include>
    <!-- including a right steering comp. -->
    <include>
      <uri>model://steering_column</uri>
      <pose>0.112 -0.0725 0 0 0 0</pose>
      <name>steer_right</name>
    </include>
    <!-- including a left front wheel -->
    <include>
      <uri>model://wheel_left</uri>
      <pose>0.118 0.081 0 0 0 0</pose>
      <name>wheel_front_left</name>
    </include>
    <!-- including a right front wheel -->
    <include>
      <uri>model://wheel_right</uri>
      <pose>0.118 -0.081 0 0 0 0</pose>
      <name>wheel_front_right</name>
    </include>
    
    <!-- including the camera link -->
    <!-- 0.261799388 -->
    <include>
      <uri>model://camera</uri>
      <pose>0 0 0.2 0 0.2617 0</pose>
      <name>camera</name>
    </include>

    <!-- includeing the car body -->
    <include>
      <uri>model://car_body</uri>
      <pose>-0.024 0.0 -0.028 0 0.0 0</pose>
      <name>car_body</name>
    </include>

    <!-- LIST OF JOINTS -->
    <joint name='joint_leftrear_rim' type='revolute'>
      <parent>chassis::link</parent>
      <child>wheel_rear_left::link_rim</child>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
        <use_parent_model_frame>0</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <joint name='joint_rightrear_rim' type='revolute'>
      <parent>chassis::link</parent>
      <child>wheel_rear_right::link_rim</child>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
        <use_parent_model_frame>0</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>
    
    <!-- Front right joint between the chassis and the steering comp. -->
    <joint name='joint_leftfront_steer' type='revolute'>
      <parent>chassis::link</parent>
      <child>steer_left::link_steer</child>
      <pose frame=''>0 0 0.005 0 -0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>0</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>
    <!-- Front left joint between the chassis and the steering comp. -->
    <joint name='joint_rightfront_steer' type='revolute'>
      <parent>chassis::link</parent>
      <child>steer_right::link_steer</child>
      <pose frame=''>0 0 -0.005 0 -0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>0</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <!-- Right joint between the steering and the rim   -->
    <joint name='joint_rightfront_rim' type='revolute'>
      <parent>steer_right::link_steer</parent>
      <child>wheel_front_right::link_rim</child>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
        <use_parent_model_frame>0</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <!-- Left joint between the steering and the rim   -->
    <joint name='joint_leftfront_rim' type='revolute'>
      <parent>steer_left::link_steer</parent>
      <child>wheel_front_left::link_rim</child>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
        <use_parent_model_frame>0</use_parent_model_frame>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <!-- fixed joint for the car body -->
    <joint name='joint_body' type='fixed'>
      <parent>chassis::link</parent>
      <child>car_body::link</child>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>


    <!-- fixed joint for the camera -->
    <joint name='joint_camera' type='fixed'>
      <parent>chassis::link</parent>
      <child>camera::link_camera</child>
      <pose frame=''>0 0 0 0 -0 0</pose>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <!-- Gazebo Sim Plugins -->
    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>joint_leftfront_rim</left_joint>
      <right_joint>joint_rightfront_rim</right_joint>
      <left_steering_joint>joint_leftfront_steer</left_steering_joint>
      <right_steering_joint>joint_rightfront_steer</right_steering_joint>
      <kingpin_width>0.145</kingpin_width>
      <steering_limit>0.5</steering_limit>
      <wheel_base>0.26</wheel_base>
      <wheel_separation>0.162</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <topic>/cmd_vel</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_update_frequency>50</static_update_frequency>
    </plugin>

  </model>
</sdf>
